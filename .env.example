# --- LLM ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.0

# --- LangSmith (Observabilité) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=sprint2-multi-agent-system
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Checkpointer ---
# "memory" (par défaut, non persistant) ou "postgres"
CHECKPOINTER_BACKEND=memory
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/agentdb

# --- API ---
API_KEY=change-me-in-prod
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
